{
	"name": "stylelint-plugin",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"prelint": "npm run build --workspaces",
		"lint": "conc --raw \"npm run lint:js\" \"npm run lint:package\"",
		"lint:js": "oxlint",
		"lint:package": "conc --raw \"publint packages/attribute-case-sensitivity\" \"publint packages/no-default-viewport\" \"publint packages/root-colors\"",
		"test": "npm run test --workspaces"
	},
	"dependencies": {
		"stylelint": "17.14.1"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"@w0s/oxlint-config": "1.0.5",
		"@w0s/tsconfig": "3.1.1",
		"concurrently": "10.0.5",
		"oxfmt": "0.65.0",
		"publint": "0.3.24",
		"rimraf": "6.1.3",
		"stylelint-test-rule-node": "1.2.0",
		"typescript": "7.0.2"
	}
}
